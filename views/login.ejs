<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Login</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f3f4f6;
      font-family: "Segoe UI", Arial, sans-serif;
      color: #1f2937;
      padding: 16px;
    }
    .card {
      width: 100%;
      max-width: 420px;
      background: #ffffff;
      padding: 32px 28px;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }
    h1 { margin: 0 0 4px; font-size: 26px; }
    .subtitle { margin: 0 0 20px; color: #6b7280; font-size: 14px; }
    label { display: block; margin: 14px 0 6px; font-size: 14px; font-weight: 600; }
    .req { color: #dc2626; margin-left: 2px; }
    input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      font-size: 15px;
    }
    input:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }
    .pw-wrap { position: relative; }
    .pw-wrap input { padding-right: 44px; }
    .toggle-pw {
      position: absolute;
      top: 50%;
      right: 8px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      margin: 0;
      padding: 0;
      background: none;
      border: none;
      border-radius: 6px;
      color: #6b7280;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .toggle-pw:hover { background: #f3f4f6; color: #1f2937; }
    .toggle-pw svg { width: 20px; height: 20px; }
    .toggle-pw .eye-off { display: none; }
    button.submit {
      width: 100%;
      margin-top: 22px;
      padding: 12px;
      background: #2563eb;
      color: #ffffff;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }
    button.submit:hover { background: #1d4ed8; }
    .errors {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 10px 14px;
      border-radius: 8px;
      margin-bottom: 8px;
      font-size: 14px;
    }
    .errors ul { margin: 0; padding-left: 18px; }
    .footer-text { text-align: center; margin-top: 18px; font-size: 14px; color: #6b7280; }
    .footer-text a { color: #2563eb; text-decoration: none; font-weight: 600; }
    .footer-text a:hover { text-decoration: underline; }
    .note { font-size: 12px; color: #6b7280; margin: 0 0 4px; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Welcome back</h1>
    <p class="subtitle">Log in to see your to-do list</p>
    <p class="note"><span class="req">*</span> required field</p>

    <% if (errors.length > 0) { %>
      <div class="errors">
        <ul>
          <% errors.forEach(function(e) { %>
            <li><%= e %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="POST" action="/login" novalidate>
      <label for="email">Email <span class="req">*</span></label>
      <input type="email" id="email" name="email" value="<%= values.email || '' %>">

      <label for="password">Password <span class="req">*</span></label>
      <div class="pw-wrap">
        <input type="password" id="password" name="password">
        <button type="button" class="toggle-pw" data-target="password" aria-label="Show password">
          <svg class="eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>

      <button type="submit" class="submit">Login</button>
    </form>

    <p class="footer-text">Don't have an account? <a href="/register">Register</a></p>
  </div>

  <script>
    document.querySelectorAll('.toggle-pw').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var input = document.getElementById(btn.dataset.target);
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('.eye').style.display = show ? 'none' : 'block';
        btn.querySelector('.eye-off').style.display = show ? 'block' : 'none';
        btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      });
    });
  </script>
  <script src="/validate.js"></script>
</body>
</html>